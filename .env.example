# RetailPulse Environment Configuration Template

# Database Connection
# For PostgreSQL (Docker / Local / Neon / Supabase):
# DATABASE_URL=postgresql://retailpulse_user:retailpulse_pass@localhost:5432/retailpulse_db
# For zero-config local testing with SQLite fallback:
DATABASE_URL=sqlite:///data/retailpulse.db

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000

# Streamlit Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO
